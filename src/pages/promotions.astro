---
import Base from "../layouts/Base.astro";
---
<Base title="คูปอง & โปรโมชัน | ร้านน้องบี" description="คูปองส่วนลดร้านน้องบี • ใช้ที่หน้า Checkout">
  <div class="rounded-3xl bg-white border border-brand-100 p-6 md:p-8">
    <h1 class="text-2xl font-extrabold text-brand-900">คูปองส่วนลด</h1>
    <p class="text-slate-600 mt-2">ใส่โค้ดคูปองที่หน้า Checkout ระบบจะตรวจสอบและคำนวณให้โดยอัตโนมัติ</p>
    <div class="mt-6 grid md:grid-cols-2 gap-4">
      <div class="rounded-2xl border border-brand-100 bg-brand-50 p-5"><div class="font-bold">NB10</div><div class="text-sm text-slate-700">ลด 10% ขั้นต่ำ 200 บาท</div></div>
      <div class="rounded-2xl border border-brand-100 bg-brand-50 p-5"><div class="font-bold">NB50</div><div class="text-sm text-slate-700">ลด 50 บาท ขั้นต่ำ 300 บาท</div></div>
      <div class="rounded-2xl border border-brand-100 bg-brand-50 p-5"><div class="font-bold">FREEMUEANG</div><div class="text-sm text-slate-700">ฟรีค่าส่ง</div></div>
      <div class="rounded-2xl border border-brand-100 bg-brand-50 p-5"><div class="font-bold">NEWBEE</div><div class="text-sm text-slate-700">ลด 15% ขั้นต่ำ 150 บาท</div></div>
    </div>
  </div>
</Base>
