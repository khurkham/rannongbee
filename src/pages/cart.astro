---
import Base from "../layouts/Base.astro";
---

<Base>
  <h1>ตะกร้าของฉัน</h1>

  <div id="cart-root">กำลังโหลด...</div>

  <p style="margin-top:1rem;">
    <a href="/menu">← เลือกเมนูเพิ่ม</a>
    &nbsp;|&nbsp;
    <a href="/checkout">ไปหน้าชำระเงิน →</a>
  </p>

  <script type="module">
    import { readCart, updateQty, removeItem, clearCart, cartTotal } from "../lib/cart";

    const root = document.getElementById("cart-root");

    function money(n){ return new Intl.NumberFormat("th-TH").format(n); }

    function render(){
      const cart = readCart();
      if (!root) return;

      if (cart.length === 0){
        root.innerHTML = `<p>ตะกร้าว่าง</p>`;
        return;
      }

      const rows = cart.map((x) => `
        <tr>
          <td>${x.name}</td>
          <td style="text-align:right;">${money(x.price)}</td>
          <td style="text-align:center;">
            <button data-dec="${x.id}">−</button>
            <span style="display:inline-block;min-width:2rem;text-align:center;">${x.qty}</span>
            <button data-inc="${x.id}">+</button>
          </td>
          <td style="text-align:right;">${money(x.price * x.qty)}</td>
          <td style="text-align:center;">
            <button data-rm="${x.id}">ลบ</button>
          </td>
        </tr>
      `).join("");

      root.innerHTML = `
        <table style="width:100%; border-collapse:collapse; gap:.5rem;">
          <thead>
            <tr>
              <th style="text-align:left;">รายการ</th>
              <th style="text-align:right;">ราคา</th>
              <th style="text-align:center;">จำนวน</th>
              <th style="text-align:right;">รวม</th>
              <th></th>
            </tr>
          </thead>
          <tbody>${rows}</tbody>
        </table>

        <div style="margin-top:1rem; display:flex; justify-content:space-between; align-items:center;">
          <button id="clear-cart">ล้างตะกร้า</button>
          <strong>ยอดรวม: ${money(cartTotal())} บาท</strong>
        </div>
      `;

      // bind events
      root.querySelectorAll("button[data-inc]").forEach((b) => {
        b.addEventListener("click", () => {
          const id = b.getAttribute("data-inc");
          const item = cart.find((x) => x.id === id);
          if (item) updateQty(item.id, item.qty + 1);
        });
      });

      root.querySelectorAll("button[data-dec]").forEach((b) => {
        b.addEventListener("click", () => {
          const id = b.getAttribute("data-dec");
          const item = cart.find((x) => x.id === id);
          if (item) updateQty(item.id, item.qty - 1);
        });
      });

      root.querySelectorAll("button[data-rm]").forEach((b) => {
        b.addEventListener("click", () => {
          const id = b.getAttribute("data-rm");
          if (id) removeItem(id);
        });
      });

      const clearBtn = document.getElementById("clear-cart");
      clearBtn?.addEventListener("click", () => clearCart());
    }

    render();
    window.addEventListener("cart:changed", render);
  </script>
</Base>
