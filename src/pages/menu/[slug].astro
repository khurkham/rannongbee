---
import Base from "../../layouts/Base.astro";
import AddToCartButton from "../../components/AddToCartButton.astro";

const { slug } = Astro.params;

// สมมติคุณมี items แบบนี้
const items = [
  { slug: "pad-thai", name: "ผัดไทย", price: 60 },
  { slug: "krapao", name: "กะเพรา", price: 55 },
];

const item = items.find((x) => x.slug === slug);
if (!item) return Astro.redirect("/menu");
---

<Base>
  <h1>{item.name}</h1>
  <p>ราคา {item.price} บาท</p>

  <AddToCartButton
    id={item.slug}
    name={item.name}
    price={item.price}
    className="btn"
  />

  <p><a href="/menu">← กลับหน้าเมนู</a></p>
</Base>
