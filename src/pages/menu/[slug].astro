---
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
  return [
    { params: { slug: "pad-thai" } },
    { params: { slug: "krapao" } },
    { params: { slug: "fried-rice" } }
  ];
}

const { slug } = Astro.params;

const menuData = {
  "pad-thai": { name: "ผัดไทย", price: 60 },
  "krapao": { name: "กะเพรา", price: 55 },
  "fried-rice": { name: "ข้าวผัด", price: 50 }
};

const item = menuData[slug];
---

<Layout>
  {item ? (
    <div style="padding:40px">
      <h1>{item.name}</h1>
      <p>ราคา {item.price} บาท</p>
    </div>
  ) : (
    <h1>ไม่พบเมนู</h1>
  )}
</Layout>
